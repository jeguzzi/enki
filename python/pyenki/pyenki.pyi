import collections.abc
import numpy
import numpy.typing
import typing
from typing import Annotated, ClassVar, TypeAlias, overload

Vector: TypeAlias = Annotated[numpy.typing.NDArray[numpy.float64], '[2, 1]']
VectorLike: TypeAlias = Annotated[numpy.typing.ArrayLike, numpy.float64, '[2, 1]']
Array1D: TypeAlias = Annotated[numpy.typing.NDArray[numpy.float64], '[n]']
Array2D: TypeAlias = Annotated[numpy.typing.NDArray[numpy.float64], '[n, m]']
IntArray1D: TypeAlias = Annotated[numpy.typing.NDArray[numpy.int64], '[n, m]']
Image: TypeAlias = Annotated[numpy.typing.NDArray[numpy.uint8], '[n, m, 3]']
Polygon: TypeAlias = collections.abc.Sequence[Vector]
Part: TypeAlias = tuple[Polygon, typing.SupportsFloat] | tuple[Polygon, typing.SupportsFloat, collections.abc.Sequence[Color]]

class Color:
    black: ClassVar[Color] = ...  # read-only
    blue: ClassVar[Color] = ...  # read-only
    gray: ClassVar[Color] = ...  # read-only
    green: ClassVar[Color] = ...  # read-only
    red: ClassVar[Color] = ...  # read-only
    white: ClassVar[Color] = ...  # read-only
    a: float
    b: float
    components: tuple[float, float, float, float]
    g: float
    r: float
    def __init__(self, r: typing.SupportsFloat = ..., g: typing.SupportsFloat = ..., b: typing.SupportsFloat = ..., a: typing.SupportsFloat = ...) -> None: ...
    def threshold(self, limits: Color) -> None: ...
    def toGray(self) -> float: ...
    @overload
    def __add__(self, arg0: typing.SupportsFloat) -> Color: ...
    @overload
    def __add__(self, arg0: Color) -> Color: ...
    def __eq__(self, arg0: object) -> bool: ...
    @overload
    def __iadd__(self, arg0: typing.SupportsFloat) -> None: ...
    @overload
    def __iadd__(self, arg0: Color) -> None: ...
    def __imul__(self, arg0: typing.SupportsFloat) -> None: ...
    @overload
    def __isub__(self, arg0: typing.SupportsFloat) -> None: ...
    @overload
    def __isub__(self, arg0: Color) -> None: ...
    def __itruediv__(self, arg0: typing.SupportsFloat) -> None: ...
    def __mul__(self, arg0: typing.SupportsFloat) -> Color: ...
    def __ne__(self, arg0: object) -> bool: ...
    @overload
    def __sub__(self, arg0: typing.SupportsFloat) -> Color: ...
    @overload
    def __sub__(self, arg0: Color) -> Color: ...
    def __truediv__(self, arg0: typing.SupportsFloat) -> Color: ...

class DifferentialWheeled(Robot):
    left_wheel_target_speed: float
    right_wheel_target_speed: float
    wheel_speed_noise: float
    def reset_encoders(self) -> None: ...
    @property
    def left_wheel_encoder_speed(self) -> float: ...
    @property
    def left_wheel_odometry(self) -> float: ...
    @property
    def max_wheel_speed(self) -> float: ...
    @property
    def right_wheel_encoder_speed(self) -> float: ...
    @property
    def right_wheel_odometry(self) -> float: ...
    @property
    def wheel_axis(self) -> float: ...

class EPuck(DifferentialWheeled):
    def __init__(self, proximity: bool = ..., camera: bool = ..., scanner: bool = ...) -> None: ...
    def set_led_ring(self, value: bool) -> None: ...
    @property
    def camera_image(self) -> Array2D: ...
    @property
    def prox_distances(self) -> Array1D: ...
    @property
    def prox_values(self) -> Array1D: ...
    @property
    def scan(self) -> Array1D: ...

class IRCommEvent:
    @property
    def intensities(self) -> IntArray1D: ...
    @property
    def payloads(self) -> IntArray1D: ...
    @property
    def rx_value(self) -> int: ...

class Marxbot(DifferentialWheeled):
    scanner_range: float
    def __init__(self) -> None: ...
    @property
    def scanner_distances(self) -> Array1D: ...
    @property
    def scanner_image(self) -> Array2D: ...

class PhysicalObject:
    angle: float
    angular_speed: float
    collision_callback: collections.abc.Callable[[PhysicalObject, PhysicalObject], None]
    collision_elasticity: float
    color: Color
    control_step_callback: collections.abc.Callable[[PhysicalObject, typing.SupportsFloat], None]
    dry_friction_coefficient: float
    name: str
    @property
    def position(self) -> Vector: ...
    @position.setter
    def position(self, value: VectorLike): ...
    @property
    def velocity(self) -> Vector: ...
    @velocity.setter
    def velocity(self, value: VectorLike): ...
    viscous_friction_coefficient: float
    viscous_moment_friction_coefficient: float
    def control_step(self, time_step: typing.SupportsFloat) -> None: ...
    @property
    def _interlaced_distance(self) -> float: ...
    @property
    def has_collided(self) -> bool: ...
    @property
    def height(self) -> float: ...
    @property
    def is_cylindric(self) -> bool: ...
    @property
    def mass(self) -> float: ...
    @property
    def moment_of_inertia(self) -> float: ...
    @property
    def radius(self) -> float: ...
    @property
    def uid(self) -> int: ...
    @property
    def world(self) -> World: ...

class Robot(PhysicalObject):
    pass

