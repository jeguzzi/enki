    def set_led_buttons(self, index: typing.SupportsInt, value: typing.SupportsFloat) -> None: ...
    def set_led_buttons_i(self, index: typing.SupportsInt, value: typing.SupportsInt) -> None: ...
    def set_led_circle(self, index: typing.SupportsInt, value: typing.SupportsFloat) -> None: ...
    def set_led_circle_i(self, index: typing.SupportsInt, value: typing.SupportsInt) -> None: ...
    def set_led_left_blue(self, value: typing.SupportsFloat) -> None: ...
    def set_led_left_blue_i(self, value: typing.SupportsInt) -> None: ...
    def set_led_left_red(self, value: typing.SupportsFloat) -> None: ...
    def set_led_left_red_i(self, value: typing.SupportsInt) -> None: ...
    def set_led_prox(self, index: typing.SupportsInt, value: typing.SupportsFloat) -> None: ...
    def set_led_prox_i(self, index: typing.SupportsInt, value: typing.SupportsInt) -> None: ...
    def set_led_right_blue(self, value: typing.SupportsFloat) -> None: ...
    def set_led_right_blue_i(self, value: typing.SupportsInt) -> None: ...
    def set_led_right_red(self, value: typing.SupportsFloat) -> None: ...
