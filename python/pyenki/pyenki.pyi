    @property
    def prox_values(self) -> Array1D: ...
    @property
    def prox_values_i(self) -> IntArray1D: ...

class World:
    control_step_callback: collections.abc.Callable[[World, typing.SupportsFloat], None]
    random_generator: numpy.random.Generator
    random_seed: int
    @overload
    def __init__(self, seed: typing.SupportsInt = ...) -> None: ...
    @overload
    def __init__(self, width: typing.SupportsFloat, height: typing.SupportsFloat, walls_color: Color = ..., seed: typing.SupportsInt = ...) -> None: ...
    @overload
    def __init__(self, radius: typing.SupportsFloat, walls_color: Color = ..., seed: typing.SupportsInt = ...) -> None: ...
    def add_object(self, object: PhysicalObject) -> None: ...
    def copy_random_generator(self, world: World) -> None: ...
    def remove_object(self, object: PhysicalObject) -> None: ...
    def render(self, camera_reset: bool = ..., camera_position: VectorLike = ..., camera_altitude: typing.SupportsFloat = ..., camera_yaw: typing.SupportsFloat = ..., camera_pitch: typing.SupportsFloat = ..., camera_is_ortho: bool = ..., walls_height: typing.SupportsFloat = ..., width: typing.SupportsFloat = ..., height: typing.SupportsFloat = ...) -> Image: ...
    def run(self, steps: typing.SupportsInt = ..., time_step: typing.SupportsFloat = ..., physics_oversampling: typing.SupportsInt = ..., termination: collections.abc.Callable[[World], bool] | None = ..., callback: collections.abc.Callable[[World], None] | None = ...) -> None: ...
    def run_in_viewer(self, fps: typing.SupportsFloat = ..., time_step: typing.SupportsFloat = ..., factor: typing.SupportsFloat = ..., helpers: bool = ..., camera_reset: bool = ..., camera_position: VectorLike = ..., camera_altitude: typing.SupportsFloat = ..., camera_yaw: typing.SupportsFloat = ..., camera_pitch: typing.SupportsFloat = ..., camera_is_ortho: bool = ..., walls_height: typing.SupportsFloat = ..., duration: typing.SupportsFloat = ...) -> None: ...
    def save_image(self, path: str, camera_reset: bool = ..., camera_position: VectorLike = ..., camera_altitude: typing.SupportsFloat = ..., camera_yaw: typing.SupportsFloat = ..., camera_pitch: typing.SupportsFloat = ..., camera_is_ortho: bool = ..., walls_height: typing.SupportsFloat = ..., width: typing.SupportsFloat = ..., height: typing.SupportsFloat = ...) -> None: ...
    def step(self, time_step: typing.SupportsFloat, physics_oversampling: typing.SupportsInt = ...) -> None: ...
    @property
    def objects(self) -> set[PhysicalObject]: ...
    @property
    def robots(self) -> list[Robot]: ...
    @property
    def static_objects(self) -> list[PhysicalObject]: ...

class WorldView:
    camera_altitude: float
    camera_is_ortho: bool
    camera_pitch: float
    camera_pose: tuple[float, float, float, float]
    @property
    def camera_position(self) -> Vector: ...
    @camera_position.setter
    def camera_position(self, value: VectorLike): ...
    camera_yaw: float
    helpers: bool
    tracking: bool
    world: World
    def __init__(self, world: World = ..., fps: typing.SupportsFloat = ..., update_world: bool = ..., time_step: typing.SupportsFloat = ..., factor: typing.SupportsFloat = ..., helpers: bool = ..., camera_reset: bool = ..., camera_position: VectorLike = ..., camera_altitude: typing.SupportsFloat = ..., camera_yaw: typing.SupportsFloat = ..., camera_pitch: typing.SupportsFloat = ..., camera_is_ortho: bool = ..., walls_height: typing.SupportsFloat = ...) -> None: ...
    def hide(self) -> None: ...
    def move_camera(self, target_position: VectorLike, target_altitude: typing.SupportsFloat = ..., target_distance: typing.SupportsFloat = ..., yaw: typing.SupportsFloat | None = ..., pitch: typing.SupportsFloat | None = ...) -> None: ...
    def point_camera(self, target_position: VectorLike, target_altitude: typing.SupportsFloat = ..., position: VectorLike | None = ..., altitude: typing.SupportsFloat | None = ...) -> None: ...
    def reset_camera(self) -> None: ...
    def save_image(self, arg0: str) -> None: ...
    def show(self) -> None: ...
    def start_updating_world(self, time_step: typing.SupportsFloat = ..., factor: typing.SupportsFloat = ...) -> None: ...
    def stop_updating_world(self) -> None: ...
    @property
    def image(self) -> Image: ...
    @property
    def walls_height(self) -> float: ...
    @property
    def widget(self) -> object: ...

def CircularObject(radius: typing.SupportsFloat, height: typing.SupportsFloat, mass: typing.SupportsFloat, color: Color = ...) -> PhysicalObject: ...
def CompositeObject(parts: list[Part], mass: typing.SupportsFloat, color: Color = ...) -> PhysicalObject: ...
def ConvexObject(base: collections.abc.Sequence[Vector], height: typing.SupportsFloat, mass: typing.SupportsFloat, color: Color = ..., face_colors: collections.abc.Sequence[Color] = ...) -> PhysicalObject: ...
def RectangularObject(l1: typing.SupportsFloat, l2: typing.SupportsFloat, height: typing.SupportsFloat, mass: typing.SupportsFloat, color: Color = ...) -> PhysicalObject: ...
def cleanup_ui() -> None: ...
def init_ui() -> None: ...
def run_ui(duration: typing.SupportsFloat = ...) -> None: ...
